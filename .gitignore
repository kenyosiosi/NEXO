# --- NEXO ENGINE: Archivos de Compilación ---
build/
bin/
obj/
out/

# --- Artefactos de CMake ---
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake

# --- Ejecutables y Librerías (Windows/Linux) ---
*.exe
*.dll
*.so
*.a
*.lib
*.pdb
*.ilk
*.exp

# --- Dependencias Externas ---
# Se descargan automaticamente con FetchContent en el momento de configurar
# el build, por lo que no se versionan ni requieren carpetas locales.

# --- Archivos de Datos del Motor ---
# Ignoramos los datos generados en runtime (.bin, .idx, .schema)
# Pero mantenemos la carpeta 'data' usando un .gitkeep si lo deseas
data/*.bin
data/*.idx
data/*.schema
# Opcional: Si quieres que la carpeta data se suba vacía, crea un archivo .gitkeep dentro
# y comenta la línea de abajo.
# data/

# --- IDEs y Editores ---
.vscode/
.vs/
*.user
*.suo
*.sln
*.vcxproj
*.filters
.idea/
*.swp
*.swo

# --- Otros ---
.DS_Store
Thumbs.db
*.log

# --- Estado local de la app (no versionar) ---
# idioma y banner de bienvenida elegidos por el usuario
data/ui.cfg
# capturas generadas por el modo demo
data/shots/
# layout persistido de ImGui
imgui.ini